# Copy to .env and fill in. The database is Neon; there is no local Postgres.
#
# Two connection strings to one database, and the difference is load-bearing:
#
#   DATABASE_URL             -> POOLED endpoint. The app opens a handful of
#                               short connections per request; PgBouncer in
#                               transaction mode is what lets Neon serve that
#                               pattern. Database.py switches the engine to
#                               NullPool when it sees "-pooler" in the host.
#   MIGRATIONS_DATABASE_URL  -> DIRECT endpoint (no "-pooler"). Alembic issues
#                               DDL, which in transaction pooling must not sit
#                               inside a transaction that may be reassigned
#                               mid-run. Alembic reads this from app.config, so
#                               `make migrate` picks it up from here.
#
# Host names differ only in the "-pooler" segment; the database is `neondb`.

DATABASE_URL="postgresql+psycopg://siroq_app:APP_ROLE_PASSWORD@ep-XXXX-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
MIGRATIONS_DATABASE_URL="postgresql+psycopg://BRANCH_OWNER:OWNER_PASSWORD@ep-XXXX.<region>.aws.neon.tech/neondb?sslmode=require"

# Shared secret the Next.js client sends as X-API-Key. Must not be the
# development default when ENVIRONMENT != development, or the app refuses to boot.
API_KEY="replace-me"

ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Upload guard rails, per request.
MAX_FILES_PER_REQUEST=25
MAX_FILE_BYTES=52428800

# Raw-file storage. Development uses a scratch directory. NEVER set
# STORAGE_DRIVER=s3 in a .env you also run pytest with: the test suite wipes
# storage between cases, and under the s3 driver that means deleting objects in
# the bucket. tests/conftest.py pins the driver to local to stop exactly that.
STORAGE_PATH="./data/storage"
# STORAGE_DRIVER="local"

# Object store, required when STORAGE_DRIVER=s3 (i.e. in every deployed
# environment — Render's filesystem is ephemeral). Neon Object Storage is
# path-style only.
# S3_ENDPOINT="https://br-XXXX.storage.<region>.aws.neon.tech"
# S3_BUCKET="uploads"
# S3_REGION="us-east-2"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"

# Namespaces this service's objects inside the bucket.
# STORAGE_KEY_PREFIX="analysis/"

# Hosts this service is willing to fetch caller-supplied URLs from. Blank means
# "only our own object store", which refuses every handoff. The SiroQ client's
# objects live on a *different* Neon branch and therefore a different host, so
# that host has to be named here or every handoff is rejected. This is an
# SSRF guard, not a hint.
# SOURCE_URL_ALLOWED_HOSTS="br-wispy-voice-b4zmsbo4.storage.c-6.us-east-2.aws.neon.tech"
